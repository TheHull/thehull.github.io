---
import type { Event } from "@/lib/events";
import { eventDate } from "@/lib/events";
import { excerptHtml } from "@/lib/excerpts";
import { sitePath } from "@/lib/links";
import ContentImage from "./ContentImage.astro";

interface Props { events: Event[]; }
const { events } = Astro.props;
---
<div class="event-list">
  {events.map((event) => {
    const href = sitePath("events/" + event.id + "/");
    return <article class:list={["entry-preview", { "has-image": event.data.image }]}>
      {event.data.image && <ContentImage image={event.data.image} href={href} />}
      <div class="preview-content">
        <h3><a href={href}>{event.data.title}</a></h3>
        <p class="metadata"><time datetime={event.id}>{eventDate(event)}</time>. {event.data.type}</p>
        <p class="excerpt" set:html={excerptHtml(event, { base: sitePath(), permalink: href })} />
      </div>
    </article>;
  })}
</div>

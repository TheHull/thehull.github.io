---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import ContentImage from "@/components/ContentImage.astro";
import { eventDate } from "@/lib/events";
import { sitePath } from "@/lib/links";
import { excerpt } from "@/lib/excerpts";
import { getPage } from "@/lib/pages";

export const getStaticPaths = (async () => {
  const events = await getCollection("events");
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { event } = Astro.props;
const { Content } = await render(event);
const page = await getPage("events");
---
<Base title={event.data.title} description={excerpt(event) || undefined}>
  <p><a href={sitePath("events/")}>← {page.data.all}</a></p>
  <article>
    <h1>{event.data.title}</h1>
    <p class="metadata"><time datetime={event.id}>{eventDate(event)}</time>. {event.data.type}</p>
    {event.data.image && <ContentImage image={event.data.image} />}
    <div class="prose"><Content /></div>
  </article>
</Base>
